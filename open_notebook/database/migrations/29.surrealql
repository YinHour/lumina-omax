DEFINE TABLE IF NOT EXISTS ai_token_usage SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS user_id ON TABLE ai_token_usage TYPE option<string>;
DEFINE FIELD IF NOT EXISTS username ON TABLE ai_token_usage TYPE string;
DEFINE FIELD IF NOT EXISTS credential_id ON TABLE ai_token_usage TYPE option<string>;
DEFINE FIELD IF NOT EXISTS credential_name ON TABLE ai_token_usage TYPE string;
DEFINE FIELD IF NOT EXISTS provider ON TABLE ai_token_usage TYPE string;
DEFINE FIELD IF NOT EXISTS model_id ON TABLE ai_token_usage TYPE option<string>;
DEFINE FIELD IF NOT EXISTS model_name ON TABLE ai_token_usage TYPE string;
DEFINE FIELD IF NOT EXISTS surface ON TABLE ai_token_usage TYPE string;
DEFINE FIELD IF NOT EXISTS request_id ON TABLE ai_token_usage TYPE option<string>;
DEFINE FIELD IF NOT EXISTS input_tokens ON TABLE ai_token_usage TYPE int;
DEFINE FIELD IF NOT EXISTS output_tokens ON TABLE ai_token_usage TYPE int;
DEFINE FIELD IF NOT EXISTS total_tokens ON TABLE ai_token_usage TYPE int;
DEFINE FIELD IF NOT EXISTS token_source ON TABLE ai_token_usage TYPE string;
DEFINE FIELD IF NOT EXISTS status ON TABLE ai_token_usage TYPE string;
DEFINE FIELD IF NOT EXISTS error_type ON TABLE ai_token_usage TYPE option<string>;
DEFINE FIELD IF NOT EXISTS duration_ms ON TABLE ai_token_usage TYPE int;
DEFINE FIELD IF NOT EXISTS created ON TABLE ai_token_usage TYPE datetime DEFAULT time::now();
DEFINE INDEX IF NOT EXISTS ai_token_usage_user_created_idx ON TABLE ai_token_usage COLUMNS user_id, created;
DEFINE INDEX IF NOT EXISTS ai_token_usage_credential_created_idx ON TABLE ai_token_usage COLUMNS credential_id, created;
DEFINE INDEX IF NOT EXISTS ai_token_usage_created_idx ON TABLE ai_token_usage COLUMNS created;
