# SurrealDB Data ency key
OPEN_NOTEBOOK_ENCRYPTION_KEY=change-me-to-a-secret-string

# DATABASE (Default values work with docker-compose.yml)
SURREAL_URL=ws://127.0.0.1:8001/rpc
SURREAL_USER=root
SURREAL_PASSWORD=root
SURREAL_NAMESPACE=open_notebook
SURREAL_DATABASE=open_notebook

# KNOWLEDGE GRAPH ENHANCEMENT (Scientific Documents)
ENABLE_KNOWLEDGE_GRAPH=true
KG_ENTITY_TYPES=MATERIAL,CHEMICAL,PROPERTY,CONDITION,RESULT,EXPERIMENT,PRODUCT,METHOD
KG_RELATION_TYPES=USES_MATERIAL,HAS_CONDITION,YIELDS_RESULT,CONTAINS_CHEMICAL,MEASURES_PROPERTY,COMPARES_WITH,APPLIES_TO

# Logger Config
LOG_LEVEL=INFO
LOG_SERVICE=api

# Vision image description tuning
## MiniMax-M3
# VISION_CONCURRENCY=6
# VISION_TEMPERATURE=0
# VISION_MAX_TOKENS=2048
## active OpenAI-compatible vision model
VISION_CONCURRENCY=2
VISION_TEMPERATURE=0
VISION_MAX_TOKENS=2048
VISION_TIMEOUT_SECONDS=120
VISION_MAX_RETRIES=2
VISION_RETRY_BASE_DELAY_SECONDS=3
VISION_REASONING_EFFORT=medium
VISION_IMAGE_DETAIL=high
## For Ollama vision models
# VISION_NUM_CTX=2048
# VISION_NUM_PREDICT=384
# For non-Ollama vision models
# VISION_MAX_TOKENS=2048

# Admin Passwd
OPEN_NOTEBOOK_PASSWORD=Welcome1

# Listen Host and Port
API_HOST=0.0.0.0
API_PORT=5056

# Timeout Settings
#CHAT_LLM_TIMEOUT_SECONDS=3
#SOURCE_CHAT_LLM_TIMEOUT_SECONDS=2
#ASK_LLM_TIMEOUT_SECONDS=2 

# LLM Heartbeat check
#CHAT_STREAM_HEARTBEAT_SECONDS=5

# LLM Context Size
## 默认120000（≈ 72k tokens，给 deepseek-v4-pro 留余量）
#NOTEBOOK_CHAT_CONTEXT_MAX_CHARS=120000
## Quick Chat 历史：协议安全消息上限 + token 预算 + 早期对话压缩摘要
#CHAT_HISTORY_MAX_MESSAGES=12
#CHAT_HISTORY_MAX_TOKENS=16000
#CHAT_HISTORY_SUMMARY_MAX_CHARS=6000
## Research Agent 历史预算与单次来源/笔记分块读取上限
#RESEARCH_AGENT_HISTORY_MAX_MESSAGES=20
#RESEARCH_AGENT_HISTORY_MAX_TOKENS=32000
#RESEARCH_AGENT_HISTORY_SUMMARY_MAX_CHARS=8000
#RESEARCH_AGENT_READ_MAX_CHARS=12000
